# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml at the repo root, or Homebrew postgresql@16)
DATABASE_URL=postgresql://coach:coach_dev_password@localhost:5432/coachconnect

# Auth. Generate with:  openssl rand -base64 48   (must be 32+ characters; different per environment)
JWT_ACCESS_SECRET=
# Access token lifetime in seconds (60-3600). Short on purpose.
ACCESS_TOKEN_TTL_SECONDS=900
# A login session ends after this many days without a refresh.
SESSION_TTL_DAYS=30

# ───── Email ─────
# console = just print emails in the backend terminal (default, nothing is sent)
# smtp    = a real mail server (Gmail App Password, Brevo, Mailtrap, ...)
# resend  = the Resend web service over HTTPS (good for production hosts that block SMTP)
MAIL_DRIVER=console
# The "From" line. With Gmail it MUST be your own Gmail address.
MAIL_FROM="Coach Connect <you@gmail.com>"
# --- only for MAIL_DRIVER=smtp (Gmail: smtp.gmail.com, port 587, SMTP_SECURE=false) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# --- only for MAIL_DRIVER=resend ---
RESEND_API_KEY=
# Check your setup any time with:   pnpm mail:test you@example.com
