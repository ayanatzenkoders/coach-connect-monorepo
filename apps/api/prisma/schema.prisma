// Coach Connect database schema (Phase 1).
// Indexes that Prisma cannot express (partial indexes, CHECK constraints) are added by hand
// in the migration SQL. They are marked "RAW" below so you know where to look.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums (every state, and what it means) ─────────────────────────

/// Who the account is. Decides which screens/APIs are allowed. Stored on the user row,
/// and read from the database on every request (never trusted from the token).
enum Role {
  MEMBER // Paying app user. Can call coaches/members, chat, be added to coach calls.
  COACH // Approved coach (created/approved by an Admin). Receives calls. Never needs a subscription.
  SUPPORT // Operations staff, web panel only, READ-ONLY (cannot ban, edit or delete).
  ADMIN // Operations lead, web panel only, can do everything incl. ban/unban.

  @@map("user_role")
}

/// Which client a login session belongs to. Mobile and admin tokens are not interchangeable.
enum SessionAudience {
  MOBILE // Member/Coach app.
  ADMIN // Web admin panel (Support/Admin).

  @@map("session_audience")
}

/// Why a session stopped working. Kept for audits ("why was this user logged out?").
enum SessionRevokeReason {
  LOGOUT // User tapped sign out.
  REPLACED // Same device signed in again; the old session was closed.
  REUSE_DETECTED // An already-used refresh token came back: possible theft, session killed.
  BANNED // Admin banned the user.
  ADMIN_REVOKED // Admin signed the device out.
  PASSWORD_CHANGED // User changed/reset password: all other devices are signed out.

  @@map("session_revoke_reason")
}

/// State of a user's access to paid features. "No row" means never subscribed.
/// Only EXPIRED and "no row" are blocked from calling.
enum SubscriptionStatus {
  TRIAL // In the free trial period. Has access.
  ACTIVE // Paid and current. Has access.
  GRACE_PERIOD // Payment failed but the store is still retrying. Has access for now.
  CANCELLED_ACTIVE // User turned off renewal but the paid period has not ended. Has access until expires_at.
  EXPIRED // Period ended or refunded. NO access.

  @@map("subscription_status")
}

/// What a verification code is for.
enum VerificationCodePurpose {
  EMAIL_VERIFICATION // 6-digit code emailed after sign-up to prove the email is real.
  PASSWORD_RESET // 6-digit code emailed by "Forgot password".

  @@map("verification_code_purpose")
}

/// Kind of chat. Only DIRECT is built today; GROUP is reserved so groups need no table changes.
enum ChatType {
  DIRECT // Exactly two members. Identified by chats.direct_key, so a pair never has two chats.
  GROUP // Many members, has a title. Not built yet.

  @@map("chat_type")
}

// ───────────────────────── Models ─────────────────────────

model User {
  /// uuid(7) = time-ordered UUID: new rows land at the end of the primary-key index (faster
  /// inserts, less index bloat than random uuid v4) and ids are not guessable counters.
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Always stored lowercase (CHECK constraint, RAW). Uniqueness is a PARTIAL unique index
  /// (RAW): unique only among accounts that are not deleted.
  email           String
  /// null for social-login-only accounts (Google/Apple, added later).
  passwordHash    String?   @map("password_hash")
  name            String
  role            Role      @default(MEMBER)
  /// null = not banned; set = banned since then. Who banned and why is kept in audit_logs (action "user.ban").
  bannedAt        DateTime? @map("banned_at") @db.Timestamptz(3)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Soft delete: set when the user deletes their account (data is anonymised separately).
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions         Session[]
  coachProfile     CoachProfile?
  subscription     Subscription?
  verificationCodes VerificationCode[]
  blocksMade        Block[]            @relation("Blocker")
  blocksReceived    Block[]            @relation("Blocked")
  chatMemberships   ChatMember[]
  messagesSent      Message[]

  @@map("users")
}

model Session {
  id                       String               @id @default(uuid(7)) @db.Uuid
  userId                   String               @map("user_id") @db.Uuid
  audience                 SessionAudience
  /// Stable id the app generates once per install. One live session per device (RAW partial unique).
  deviceId                 String               @map("device_id")
  deviceName               String?              @map("device_name")
  /// sha256 of the CURRENT refresh secret. The secret itself is never stored.
  refreshTokenHash         String               @map("refresh_token_hash")
  /// sha256 of the PREVIOUS secret, used to detect reuse (theft) and to allow a short retry grace.
  previousRefreshTokenHash String?              @map("previous_refresh_token_hash")
  rotatedAt                DateTime             @default(now()) @map("rotated_at") @db.Timestamptz(3)
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt               DateTime             @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Inactivity limit; pushed forward on every refresh.
  expiresAt                DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt                DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokedReason            SessionRevokeReason? @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // "all sessions of a user" (ban, logout-all, active devices screen)
  @@map("sessions")
}

model CoachProfile {
  userId      String   @id @map("user_id") @db.Uuid
  bio         String   @default("")
  specialties String[] @default([])
  /// Admin has approved this coach. Unapproved coaches are invisible in People.
  approved    Boolean  @default(false) @map("is_approved")
  /// Coach switched "available" on. Only available coaches show a Call button.
  available   Boolean  @default(false) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// GIN = index for "does this array contain X" (specialty filter).
  @@index([specialties], type: Gin)
  @@map("coach_profiles")
}

model Subscription {
  id        String             @id @default(uuid(7)) @db.Uuid
  /// One row per user (unique). No row = never subscribed.
  userId    String             @unique @map("user_id") @db.Uuid
  status    SubscriptionStatus
  /// "monthly" | "yearly".
  plan      String?
  /// End of the current paid/trial period. Access holds until this moment for CANCELLED_ACTIVE.
  expiresAt DateTime?          @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// "A has blocked B". Hidden from each other in People/search/calls/chat, in both directions.
model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId]) // also stops duplicate blocks; serves "who did I block"
  @@index([blockedId]) // reverse lookup: "who blocked me" (needed for the either-direction check)
  @@map("user_blocks")
}

/// A short code we email to a user (verify email, reset password).
/// We store only an HMAC of the code, never the code itself.
model VerificationCode {
  id             String                  @id @default(uuid(7)) @db.Uuid
  userId         String                  @map("user_id") @db.Uuid
  purpose        VerificationCodePurpose
  codeHash       String                  @map("code_hash")
  expiresAt      DateTime                @map("expires_at") @db.Timestamptz(3)
  /// Wrong guesses so far. After 5 the code is locked and a new one must be requested.
  failedAttempts Int                     @default(0) @map("failed_attempts")
  /// Set when the code was used OR replaced by a newer one. null = still active.
  consumedAt     DateTime?               @map("consumed_at") @db.Timestamptz(3)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_codes")
}

/// Who did what to whom. Written for every admin write (ban, unban, ...) and later every
/// transcript view. Append-only: the app never updates or deletes rows.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String // e.g. "user.ban", "user.unban"
  targetType String?  @map("target_type") // e.g. "user"
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt]) // "what did this admin do, newest first"
  @@index([targetType, targetId, createdAt]) // "history of this user"
  @@index([createdAt]) // global feed
  @@map("audit_logs")
}

/// A chat room. Who is in it is stored in chat_members (one row per person), so the same shape
/// serves a one-to-one chat today and a group chat later.
model Chat {
  id    String   @id @default(uuid(7)) @db.Uuid
  type  ChatType
  /// DIRECT only: "<smaller user id>:<larger user id>". Unique, so two people can never have two
  /// chats; "A opens B" and "B opens A" find the same row. null for groups (CHECK, RAW).
  directKey String? @unique @map("direct_key")
  /// GROUP only.
  title String?
  /// Number of the newest message. Each new message takes this + 1 (see ChatService.send).
  lastMessageSequenceNumber Int       @default(0) @map("last_message_sequence_number")
  /// null until the first message: empty chats stay out of the Messages list.
  lastMessageAt             DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  members  ChatMember[]
  messages Message[]

  @@map("chats")
}

/// Junction between users and chats: "this user is in this chat". It also stores how far that
/// user has read, as ONE number. Reading 1000 messages = one UPDATE of this row, never a write per message.
model ChatMember {
  chatId String @map("chat_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// Highest message number this user has read. A message is "seen" by the user when its
  /// sequence_number is <= this. Unread = chats.last_message_sequence_number - this.
  lastReadSequenceNumber Int      @default(0) @map("last_read_sequence_number")
  joinedAt               DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId]) // "my chats"
  @@map("chat_members")
}

model Message {
  id              String   @id @default(uuid(7)) @db.Uuid
  chatId          String   @map("chat_id") @db.Uuid
  senderId        String   @map("sender_id") @db.Uuid
  /// Made by the app for every message it sends. If the same id arrives twice (a retry after a
  /// bad connection) we return the first message instead of saving a duplicate.
  clientMessageId String   @map("client_message_id")
  /// 1, 2, 3 ... inside its chat: the order everyone sees, and the "give me everything after N" cursor.
  sequenceNumber  Int      @map("sequence_number")
  body            String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientMessageId]) // makes sending idempotent
  @@unique([chatId, sequenceNumber]) // also the index behind "messages of this chat, in order"
  @@map("messages")
}
