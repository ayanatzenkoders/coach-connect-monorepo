# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# React Native Firebase v27 (SPM) requires dynamic frameworks: https://rnfirebase.io/ios-spm
linkage = ENV['USE_FRAMEWORKS'] || 'dynamic'
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'CoachConnect' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react-native-image-picker uses Apple UTType APIs but its podspec does not link the
    # frameworks. Dynamic linking (needed by Firebase) then fails, so link them here.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'react-native-image-picker'
      target.build_configurations.each do |bc|
        flags = bc.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
        flags = [flags] if flags.is_a?(String)
        bc.build_settings['OTHER_LDFLAGS'] = flags + ['-framework', 'UniformTypeIdentifiers', '-framework', 'MobileCoreServices']
      end
    end
  end
end
