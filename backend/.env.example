# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml at the repo root)
DATABASE_URL=postgresql://coach:coach_dev_password@localhost:5432/coachconnect

# Auth (Phase 1): use long random strings, different in every environment
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# LiveKit (Phase 3): from your LiveKit Cloud project
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Coach group-call limits (see Detailed Plan, rule R3)
MAX_GUESTS_PER_COACH_CALL=4
